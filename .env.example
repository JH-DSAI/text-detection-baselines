# Copy to .env and fill in what you need. Variables set in the environment take
# precedence over this file, and a blank value counts as unset.

# azure-batch model: the Azure ML batch endpoint. Required settings (need
# to be filled in):
TDB_AZURE_BATCH_STORAGE_ACCOUNT_URL=
TDB_AZURE_BATCH_DATASTORE_NAME=
TDB_AZURE_BATCH_ML_SUBSCRIPTION_ID=
TDB_AZURE_BATCH_ML_RESOURCE_GROUP=
TDB_AZURE_BATCH_ML_WORKSPACE_NAME=

# azure-batch model, optional, shown with their defaults.
# TDB_AZURE_BATCH_STORAGE_CONTAINER=text-detect-uploads-staging
# TDB_AZURE_BATCH_ENDPOINT_NAME=text-detection-batch-processing
# TDB_AZURE_BATCH_PIPELINE_CONFIG_ASSET=azureml:pipeline_config_yaml:8
# TDB_AZURE_BATCH_DETECTION_POOL_ASSET=azureml:detection_pool:5
# TDB_AZURE_BATCH_ASSIGNMENT_DEFAULT_WORD_COUNT=300
# TDB_AZURE_BATCH_BLOB_PREFIX=text-detection-baselines
# TDB_AZURE_BATCH_POLL_INTERVAL_SECONDS=30
# TDB_AZURE_BATCH_TIMEOUT_SECONDS=3600
# Unset sends all of a question's answers in one job; set, at most this many per job.
# TDB_AZURE_BATCH_MAX_BATCH_SIZE=

# Azure credentials (AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET, ...)
# are not read from this file. Export them, or use `az login`.

# Where the prepared gede dataset is written and looked up. Unset, that is
# datasets/gede_essays.jsonl in a source checkout, otherwise
# ${XDG_CACHE_HOME:-~/.cache}/text-detection-baselines/gede_essays.jsonl.
# TDB_GEDE_PATH=
